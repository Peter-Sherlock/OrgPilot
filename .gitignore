# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.pytest-tmp/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
.uv-cache/

# Build artifacts
build/
dist/
*.egg-info/

# Local configuration and secrets
.env
.env.*
!.env.example
*.local

# Editors and operating systems
.idea/
.vscode/
.DS_Store
Thumbs.db

# Runtime output
var/
*.log

# Local runtime database and SQLite sidecar files
/orgpilot.db
/orgpilot.db-wal
/orgpilot.db-shm

# Git metadata lives here because the desktop sandbox mounts .git read-only.
.git-data/

# Generated intent evaluation reports are not version-controlled; baselines live in BASELINE.md
evals/intent/reports/

# LLM compatibility probe reports are local-only (spend-gated live diagnostics)
reports/compat/

# Real team rosters hold colleagues' emails; only team.example.yaml is tracked
/team.yaml
/team.*.yaml
!/team.example.yaml
