# External providers are opt-in. Never commit real secrets.
ORGPILOT_LLM_PROVIDER=mock
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com
AIHUBMIX_MODEL=gpt-5.6-luna

# DeepSeek official Anthropic-format endpoint (deepseek-flash = DeepSeek-V4.1-Flash)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

# Anthropic-format thinking switch for online providers: omit | disabled | enabled
# Default depends on the provider: aihubmix -> omit (field never sent), deepseek -> disabled
# ORGPILOT_LLM_THINKING=

# Intent layer client: heuristic (mock demo default) | llm (DeepSeek/AIHubMix, step 3b)
# ORGPILOT_INTENT_CLIENT=heuristic

ORGPILOT_DATABASE_URL=sqlite+aiosqlite:///./orgpilot.db
ORGPILOT_API_TOKEN=

ORGPILOT_COLLABORATION_ADAPTER=mock
ORGPILOT_FEISHU_PROJECT_ID=feishu-project
# Demo only: the first sender to an empty project becomes its PM with demo tasks.
# Real teams import members and tasks with `orgpilot team import team.yaml`.
ORGPILOT_DEMO_MODE=false
# Approved reschedules always update OrgPilot. Set true only if task ids are real Feishu
# task guids: tasks imported from team.yaml are not Feishu tasks, so patching them fails.
ORGPILOT_FEISHU_TASK_WRITEBACK=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
