# External providers are opt-in. Never commit real secrets.
ORGPILOT_LLM_PROVIDER=mock
AIHUBMIX_API_KEY=
AIHUBMIX_BASE_URL=https://aihubmix.com
AIHUBMIX_MODEL=gpt-5.6-luna
# Optional Anthropic-format thinking control. For DeepSeek extraction use none;
# this sends thinking.type=disabled and avoids thinking-only responses.
ORGPILOT_LLM_REASONING_EFFORT=
# DeepSeek example:
# AIHUBMIX_BASE_URL=https://api.deepseek.com/anthropic
# AIHUBMIX_MODEL=deepseek-v4-flash
# ORGPILOT_LLM_REASONING_EFFORT=none

ORGPILOT_DATABASE_URL=sqlite+aiosqlite:///./orgpilot.db
ORGPILOT_API_TOKEN=

ORGPILOT_COLLABORATION_ADAPTER=mock
ORGPILOT_FEISHU_PROJECT_ID=feishu-project
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=

# Opt-in demo experience: auto-inject the sandbox task chain on a first Feishu
# message when the project has no tasks. Keep false in production.
ORGPILOT_DEMO_BOOTSTRAP=false

# Team reference timezone used to resolve relative times ("明天下午5点" etc.)
# in LLM claim extraction. Must be a valid IANA timezone name.
ORGPILOT_TIMEZONE=Asia/Shanghai

# Directive lifecycle: auto-reminder to targets after N minutes without an
# acknowledgement; escalation notice to the issuer after M minutes.
ORGPILOT_DIRECTIVE_REMINDER_MINUTES=60
ORGPILOT_DIRECTIVE_ESCALATION_MINUTES=1440

# Outbound delivery (transactional outbox): failed sends retry with linear
# backoff, dead-letter after N attempts; a background sweep recovers commands
# stranded between "event persisted" and "sent" (e.g. after a crash).
ORGPILOT_OUTBOX_MAX_ATTEMPTS=3
ORGPILOT_OUTBOX_RETRY_SECONDS=30
ORGPILOT_OUTBOX_SWEEP_SECONDS=15
